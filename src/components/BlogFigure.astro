---
/*
 * Reference illustrations drawn in the page's own world, in the reader's language.
 * They show where things are (a badge, a menu, a setting), never a real channel or video.
 */
import type { FigureCopy, FigureKind } from '../blog/types';
import { svg } from './icons';

interface Props { kind: FigureKind; copy: FigureCopy; note: string }
const { kind, copy, note } = Astro.props;
const { badge: b, menu: m, prefs: p, feed: f, route: r, lookup: l, week: w } = copy;
const caption = copy[kind]?.caption ?? '';
---

<figure class={`fig fig-${kind}`}>
  <div class="fig-stage" aria-hidden="true">
    {kind === 'badge' && b && (
      <div class="cards">
        {b.cards.map((c, i) => (
          <div class={`vcard${c.badge ? ' is-dubbed' : ''}`}>
            <div class={`thumb t${i}`}><span class="dur mono">{i ? '8:12' : '12:04'}</span></div>
            <div class="vmeta">
              <span class="avatar" />
              <div>
                <p class="vtitle">{c.title}</p>
                <p class="vchan">{c.channel}</p>
                {c.badge && <span class="ytbadge">{c.badge}</span>}
              </div>
            </div>
            {c.badge && <p class="pointer"><Fragment set:html={svg('arrow', 'i sm')} />{b.pointer}</p>}
          </div>
        ))}
      </div>
    )}

    {kind === 'menu' && m && (
      <div class="menu-wrap">
        <div class="player">
          <span class="bar-prog"><span /></span>
          <span class="ctrls">
            <Fragment set:html={svg('play', 'i sm')} />
            <span class="gear"><Fragment set:html={svg('gear', 'i sm')} /></span>
          </span>
        </div>
        <div class="panels">
          <div class="panel">
            <p class="ph">{m.settings}</p>
            {m.rows.map(([k, v]) => <p class="row"><span>{k}</span><span class="val">{v}<Fragment set:html={svg('right', 'i xs')} /></span></p>)}
            <p class="row hl"><span>{m.audio}</span><span class="val">{m.dubbed}<Fragment set:html={svg('right', 'i xs')} /></span></p>
          </div>
          <span class="step-arrow"><Fragment set:html={svg('arrow')} /></span>
          <div class="panel">
            <p class="ph"><Fragment set:html={svg('left', 'i xs')} />{m.audio}</p>
            <p class="row del"><span class="mk mono">−</span><s>{m.dubbed}</s></p>
            <p class="row"><span class="mk" /><span>{m.other}</span></p>
            <p class="row ins"><span class="mk mono">+</span><span>{m.original}</span><Fragment set:html={svg('check', 'i sm ok')} /></p>
          </div>
        </div>
      </div>
    )}

    {kind === 'prefs' && p && (
      <div class="prefs">
        <p class="crumb mono">{p.path}</p>
        <p class="ph"><Fragment set:html={svg('languages', 'i sm')} />{p.heading}</p>
        <p class="row"><span class="mk" /><span>{p.have}</span><Fragment set:html={svg('check', 'i sm')} /></p>
        <p class="row ins"><span class="mk mono">+</span><span>{p.add}</span><Fragment set:html={svg('check', 'i sm ok')} /></p>
        <p class="prefs-foot"><span class="confirm">{p.confirm}</span></p>
      </div>
    )}

    {kind === 'feed' && f && (
      <div class="feed">
        <p class="feed-head mono">{f.label}</p>
        {f.rows.map((row, i) => (
          <p class={`frow${row.dubbed ? ' del' : ''}`}>
            <span class="ln mono">{i + 1}</span>
            <span class="mk mono">{row.dubbed ? '−' : ''}</span>
            <span class={`mini t${i % 3}`} />
            {row.dubbed ? <s>{row.title}</s> : <span>{row.title}</span>}
            {row.dubbed && <span class="chip mono">{f.removed}</span>}
          </p>
        ))}
      </div>
    )}

    {kind === 'route' && r && (
      <div class="route">
        <p class="rrow del">
          <span class="mk mono">−</span>
          <span class="tok mono">{r.word}</span>
          <Fragment set:html={svg('arrow', 'i sm')} />
          <span class="tok via">{r.via}</span>
          <Fragment set:html={svg('arrow', 'i sm')} />
          <span class="tok idea"><Fragment set:html={svg('bulb', 'i sm')} />{r.meaning}</span>
          <span class="rlabel">{r.slow}</span>
        </p>
        <p class="rrow ins">
          <span class="mk mono">+</span>
          <span class="tok mono">{r.word}</span>
          <Fragment set:html={svg('arrow', 'i sm')} />
          <span class="tok idea"><Fragment set:html={svg('bulb', 'i sm')} />{r.meaning}</span>
          <span class="rlabel">{r.fast}</span>
        </p>
      </div>
    )}

    {kind === 'lookup' && l && (
      <div class="lookup">
        <p class="page-text">{l.before}<mark>{l.word}</mark>{l.after}</p>
        <div class="pop">
          <div class="pop-head">
            <span class="pword">{l.word}</span>
            <span class="phon mono">{l.phonetic}</span>
            <Fragment set:html={svg('volume', 'i sm')} />
          </div>
          <p class="ptr"><span class="plang">{l.lang}</span><span class="pmean">{l.translation}</span></p>
          <span class="psave">{l.save}</span>
        </div>
      </div>
    )}

    {kind === 'week' && w && (
      <div class="week">
        <p class="feed-head mono">{w.label}</p>
        {w.days.map((d, i) => (
          <p class={`wrow${i === 0 ? ' ins' : ''}`}>
            <span class="ln mono">{d.day}</span>
            <span class="wbar"><span style={`width:${Math.round(((i + 1) / w.days.length) * 100)}%`} /></span>
            <span class="wplan">{d.plan}</span>
          </p>
        ))}
      </div>
    )}
  </div>
  <figcaption>{caption} {note && <span class="note">{note}</span>}</figcaption>
</figure>

<style>
  .fig { margin: 34px 0 30px; }
  .fig-stage { border: 1px solid var(--line); border-radius: 14px; background: var(--gutter); padding: clamp(16px, 3vw, 28px); overflow: hidden; }
  figcaption { margin-top: 12px; font-size: 14px; line-height: 1.5; color: var(--muted); }
  figcaption .note { display: block; font-size: 12.5px; opacity: 0.85; margin-top: 2px; }
  .mk { width: 14px; flex: none; text-align: center; font-weight: 600; }
  :global(.i.xs) { width: 14px; height: 14px; }

  /* Badge: two video cards, the dubbed one called out */
  .cards { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; max-width: 620px; margin-inline: auto; }
  .vcard { position: relative; }
  .thumb { position: relative; aspect-ratio: 16 / 9; border-radius: 10px; background: linear-gradient(135deg, #c9d3dd, #e6ebf0); }
  .thumb.t1 { background: linear-gradient(135deg, #d8e0d2, #eef2ea); }
  .dur { position: absolute; right: 6px; bottom: 6px; background: rgba(31, 35, 40, 0.85); color: #fff; font-size: 11px; padding: 2px 5px; border-radius: 4px; }
  .vmeta { display: flex; gap: 10px; margin-top: 10px; }
  .avatar { width: 28px; height: 28px; border-radius: 50%; background: #d1d9e0; flex: none; }
  .vtitle { font-weight: 600; font-size: 15px; line-height: 1.3; }
  .vchan { font-size: 13px; color: var(--muted); margin-top: 3px; }
  .ytbadge { display: inline-block; margin-top: 6px; font-size: 12px; font-weight: 500; padding: 3px 7px; border-radius: 5px; background: #e6ebf0; color: #3d444d; }
  .is-dubbed .ytbadge { box-shadow: 0 0 0 2px var(--amber); }
  .pointer { display: flex; align-items: center; gap: 6px; margin-top: 10px; font-size: 13px; font-weight: 500; color: var(--amber-ink); background: var(--amber-bg); border: 1px solid #f3d58a; border-radius: 8px; padding: 6px 9px; width: fit-content; }
  .pointer :global(.i) { transform: rotate(-90deg); }

  /* Menu: player, then the two settings panels */
  .player { position: relative; height: 92px; border-radius: 10px; background: linear-gradient(160deg, #2b3137, #1f2328); }
  .bar-prog { position: absolute; left: 14px; right: 14px; bottom: 38px; height: 3px; background: rgba(255, 255, 255, 0.25); border-radius: 2px; }
  .bar-prog span { display: block; width: 38%; height: 100%; background: var(--del); border-radius: 2px; }
  .ctrls { position: absolute; left: 14px; right: 14px; bottom: 10px; display: flex; justify-content: space-between; align-items: center; color: #fff; }
  .gear { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; box-shadow: 0 0 0 2px var(--amber); }
  .panels { display: grid; grid-template-columns: 1fr auto 1fr; gap: 12px; align-items: start; margin-top: 14px; }
  .step-arrow { align-self: center; color: var(--muted); }
  .panel { background: var(--paper); border: 1px solid var(--line); border-radius: 12px; padding: 6px; box-shadow: 0 8px 24px -16px rgba(31, 35, 40, 0.35); font-size: 14px; }
  .ph { display: flex; align-items: center; gap: 6px; font-weight: 600; padding: 8px 10px 10px; border-bottom: 1px solid var(--line-soft); margin-bottom: 4px; }
  .row { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 8px; line-height: 1.35; }
  .panel .row > span:first-child:not(.mk) { flex: 1; white-space: nowrap; }
  .val { display: inline-flex; align-items: center; gap: 2px; color: var(--muted); font-size: 13px; text-align: right; }
  .row.hl { box-shadow: inset 0 0 0 2px var(--amber); background: var(--amber-bg); }
  .row.del { background: var(--del-bg); color: var(--del); }
  .row.ins { background: var(--ins-bg); color: var(--ins); font-weight: 600; }
  .row.ins > span:nth-child(2), .row.del s { flex: 1; }
  .ok { margin-left: auto; }

  /* Preferred languages */
  .prefs { max-width: 420px; margin-inline: auto; background: var(--paper); border: 1px solid var(--line); border-radius: 12px; padding: 8px; box-shadow: 0 8px 24px -16px rgba(31, 35, 40, 0.35); font-size: 15px; }
  .crumb { font-size: 12px; color: var(--muted); padding: 6px 10px 0; }
  .prefs .row > span:nth-child(2) { flex: 1; }
  .prefs-foot { display: flex; justify-content: flex-end; padding: 10px 6px 4px; }
  .confirm { font-weight: 600; font-size: 14px; padding: 7px 14px; border-radius: 999px; background: var(--ink); color: #fff; }

  /* Feed after Active Immersion: a diff of the home page */
  .feed, .week { background: var(--paper); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; font-size: 15px; }
  .feed-head { font-size: 12.5px; font-weight: 600; padding: 10px 14px; border-bottom: 1px solid var(--line); background: var(--gutter); }
  .frow { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-bottom: 1px solid var(--line-soft); line-height: 1.35; }
  .frow:last-child { border-bottom: 0; }
  .frow.del { background: var(--del-bg); color: var(--del); }
  .ln { width: 16px; flex: none; font-size: 12px; color: var(--muted); text-align: right; }
  .mini { width: 56px; aspect-ratio: 16 / 9; border-radius: 5px; flex: none; background: linear-gradient(135deg, #c9d3dd, #e6ebf0); }
  .mini.t1 { background: linear-gradient(135deg, #d8e0d2, #eef2ea); }
  .frow.del .mini { opacity: 0.45; }
  .frow > s, .frow > span:nth-child(4) { flex: 1; min-width: 0; }
  .chip { flex: none; font-size: 11px; padding: 3px 7px; border-radius: 999px; background: var(--del-hi); color: var(--del); }

  /* Route: through the learner's language (removed) or straight to the meaning (inserted) */
  .route { display: grid; gap: 10px; max-width: 640px; margin-inline: auto; }
  .rrow { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 14px; border-radius: 12px; border: 1px solid var(--line); background: var(--paper); font-size: 15px; }
  .rrow.del { background: var(--del-bg); border-color: var(--del-hi); color: var(--del); }
  .rrow.ins { background: var(--ins-bg); border-color: var(--ins-hi); color: var(--ins); }
  .tok { display: inline-flex; align-items: center; gap: 5px; padding: 4px 9px; border-radius: 8px; background: var(--paper); color: var(--ink); border: 1px solid var(--line); font-weight: 600; }
  .tok.via { text-decoration: line-through; text-decoration-color: var(--del); }
  .tok.idea { background: var(--amber-bg); border-color: #f3d58a; color: var(--amber-ink); }
  .rlabel { margin-left: auto; font-size: 13px; font-weight: 600; }

  /* Lookup: a line of an English page and the double-click card under the word */
  .lookup { max-width: 560px; margin-inline: auto; }
  .page-text { font-size: 17px; line-height: 1.6; color: #3d444d; background: var(--paper); border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; }
  .page-text mark { background: #b6d6ff; color: var(--ink); border-radius: 3px; padding: 0 2px; }
  .pop { margin: 10px 0 0 clamp(0px, 12vw, 120px); width: min(300px, 100%); background: var(--paper); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; box-shadow: 0 14px 34px -18px rgba(31, 35, 40, 0.45); }
  .pop-head { display: flex; align-items: baseline; gap: 8px; color: var(--muted); }
  .pword { font-size: 22px; font-weight: 700; color: var(--ink); letter-spacing: -0.02em; }
  .phon { font-size: 13px; }
  .ptr { display: flex; align-items: baseline; gap: 8px; margin-top: 4px; }
  .plang { font-size: 11px; font-weight: 600; color: var(--muted); }
  .pmean { font-size: 17px; font-weight: 700; color: var(--ins); }
  .psave { display: inline-block; margin-top: 10px; font-size: 13px; font-weight: 600; padding: 7px 12px; border-radius: 8px; background: var(--go); color: #fff; }

  /* Week: goals that grow */
  .wrow { display: grid; grid-template-columns: 52px 90px 1fr; align-items: center; gap: 12px; padding: 10px 14px; border-bottom: 1px solid var(--line-soft); line-height: 1.35; }
  .wrow:last-child { border-bottom: 0; }
  .wrow .ln { width: auto; text-align: left; }
  .wrow.ins { background: var(--ins-bg); color: var(--ins); font-weight: 600; }
  .wbar { height: 6px; border-radius: 99px; background: var(--line-soft); overflow: hidden; }
  .wbar span { display: block; height: 100%; background: var(--go); border-radius: 99px; }

  @media (max-width: 640px) {
    .cards { grid-template-columns: 1fr; }
    .vcard:not(.is-dubbed) { display: none; }
    .panels { grid-template-columns: 1fr; }
    .step-arrow { justify-self: center; transform: rotate(90deg); }
    .mini { display: none; }
    .frow { flex-wrap: wrap; }
    .frow > s, .frow > span:nth-child(4) { flex-basis: calc(100% - 60px); }
    .chip { margin-left: 44px; }
    .rlabel { margin-left: 22px; flex-basis: 100%; }
    .wrow { grid-template-columns: 44px 1fr; }
    .wbar { display: none; }
  }
</style>
