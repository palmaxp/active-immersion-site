---
/* Head, top bar and footer shared by every blog page. */
import '../styles/site.css';
import { CONTACT, SITE, STORE } from '../i18n/copy';
import { HTML_LANG, OG_LOCALE, UI, landingPrefix, prefix, type BlogLang } from '../blog/i18n';

interface Props {
  lang: BlogLang;
  title: string;
  description: string;
  path: string;
  alternates: { hreflang: string; href: string }[];
  jsonLd: object;
  ogType?: 'article' | 'website';
}
const { lang, title, description, path, alternates, jsonLd, ogType = 'website' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const ui = UI[lang];
const url = `${SITE}${path}`;
const og = `${SITE}og-${lang === 'pt' ? 'pt' : 'en'}.png`;
---

<!doctype html>
<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="Active Immersion" />
    <meta property="og:image" content={og} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" href={`${base}icon-32.png`} />
    <link rel="apple-touch-icon" href={`${base}icon-128.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Spline+Sans:wght@400;500;600;700&family=Spline+Sans+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="bar scrolled">
      <a class="brand" href={`${base}${landingPrefix(lang)}`} aria-label={`Active Immersion · ${ui.home}`}>
        <img src={`${base}icon-128.png`} width="28" height="28" alt="" />
        <span>Active Immersion</span>
      </a>
      <nav class="bar-actions">
        <a class="switch" href={`${base}${prefix(lang)}blog/`}>{ui.blog}</a>
        <a class="btn btn-sm" href={STORE.chrome}>{ui.install}</a>
      </nav>
    </header>

    <slot />

    <footer class="foot">
      <div class="wrap foot-grid">
        <a class="brand" href={`${base}${landingPrefix(lang)}`}><img src={`${base}icon-128.png`} width="24" height="24" alt="" /><span>Active Immersion</span></a>
        <nav>
          <a href={`${base}${prefix(lang)}blog/`}>{ui.blog}</a>
          <a href={`${base}privacy/`}>{ui.privacy}</a>
          <a href={`mailto:${CONTACT}`}>{ui.contact}</a>
          <a href={STORE.chrome}>Chrome Web Store</a>
          <a href={STORE.firefox}>Firefox Add-ons</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
