            <button class="btn btn-lg btn-mobile" type="button" data-share hidden>
              <Fragment set:html={svg('send', 'i')} /><span>{c.cta.mobile}</span>
            </button>
            <p class="alt-link"><span data-alt-text>{c.cta.otherFirefox}</span> <a href={STORE.firefox} data-alt>{c.cta.firefox}</a></p>
          </div>
        </div>
      </section>

      <!-- Privacy -->
      <section class="privacy">
        <div class="wrap privacy-grid">
          <div>
            <h2><Fragment set:html={svg('shield', 'i lg')} />{c.privacy.h}</h2>
            <p class="sub answer">{c.privacy.a}</p>
          </div>
          <ul class="status-checks boxed">
            {c.privacy.points.map((p) => <li><Fragment set:html={svg('check', 'i sm')} /><span>{p}</span><em class="mono">{c.price.tag}</em></li>)}
          </ul>
          <a class="text-link" href={`${base}privacy/`}>{c.privacy.link} <Fragment set:html={svg('arrow', 'i sm')} /></a>
        </div>
      </section>

      <!-- FAQ as review threads -->
      <section class="faq">
        <div class="wrap">
          <h2>{c.faq.h}</h2>
          <div class="threads">
            {c.faq.items.map((f) => (
              <details class="qa">
                <summary><span class="avatar q" aria-hidden="true"><Fragment set:html={svg('question', 'i sm')} /></span><span class="qtext">{f.q}</span><Fragment set:html={svg('chevron', 'i chev')} /></summary>
                <div class="reply"><img src={`${base}icon-128.png`} width="22" height="22" alt="" /><p>{f.a}</p></div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <!-- Final close: one more diff -->
      <section class="final">
        <div class="poster small">
          <p class="pline del" data-strike data-gut="−" aria-hidden="true"><span class="ptext"><s>{c.final.del}</s></span></p>
          <p class="pline ins" data-insert data-gut="+"><span class="ptext">{c.final.ins}</span></p>
        </div>
        <div class="final-cta">
          <a class="btn btn-lg" href={STORE.chrome} data-cta data-cta-label>
            <span data-label>{c.cta.chrome}</span>
            <small>{c.cta.sub}</small>
            <Fragment set:html={svg('arrow', 'i')} />
          </a>
          <button class="btn btn-lg btn-mobile" type="button" data-share hidden>
            <Fragment set:html={svg('send', 'i')} /><span>{c.cta.mobile}</span>
          </button>
          <p>{c.final.p}</p>
        </div>
      </section>
    </main>

    <aside class="byline wrap" aria-label={c.byline.by}>
      <span class="avatar mono" aria-hidden="true">J</span>
      <div>
        <p><a href={AUTHOR.github} rel="author noopener" target="_blank">{c.byline.by}</a></p>
        <p class="mono updated"><time datetime="2026-09-27">{c.byline.updated}</time></p>
      </div>
    </aside>

    <footer class="foot">
      <div class="wrap foot-grid">
        <a class="brand" href={here}><img src={`${base}icon-128.png`} width="24" height="24" alt="" /><span>{c.footer.rights}</span></a>
        <nav>
          <a href={`${base}privacy/`}>{c.footer.privacy}</a>
          <a href={`mailto:${CONTACT}`}>{c.footer.contact}</a>
          <a href={STORE.chrome}>Chrome Web Store</a>
          <a href={STORE.firefox}>Firefox Add-ons</a>
          <a href={other} data-switch={otherLang} hreflang={otherLang === 'pt' ? 'pt-BR' : 'en'}>{c.nav.switchTo}</a>
        </nav>
      </div>
    </footer>

    <div class="dock" data-dock>
      <a class="btn" href={STORE.chrome} data-cta data-cta-label><span data-label>{c.cta.chrome}</span><small>{c.cta.sub}</small></a>
      <button class="btn btn-mobile" type="button" data-share hidden><Fragment set:html={svg('send', 'i sm')} /><span>{c.cta.mobile}</span></button>
    </div>

    <div class="toast" role="status" aria-live="polite" data-toast></div>

    <script is:inline define:vars={{ labels: c.cta, store: STORE, hunkCount: c.sites.length, helps: how[0].levelHelp }}>
      (() => {
        const $ = (s, r = document) => r.querySelector(s);
        const $$ = (s, r = document) => [...r.querySelectorAll(s)];
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

        /* Language switch remembers the choice. */
        $$('[data-switch]').forEach((a) => a.addEventListener('click', () => { try { localStorage.setItem('ai-site-lang', a.dataset.switch); } catch (e) {} }));

        /* Browser: the main button goes to the right store; phones get "send to my computer". */
        const ua = navigator.userAgent;
        const firefox = /Firefox\//.test(ua);
        const label = /Edg\//.test(ua) ? labels.edge : /OPR\//.test(ua) ? labels.opera : firefox ? labels.firefox : labels.chrome;
        const mobile = /Android|iPhone|iPad|iPod|Mobi/i.test(ua) || (matchMedia('(pointer: coarse)').matches && innerWidth < 900);
        $$('[data-cta]').forEach((a) => { if (firefox) a.href = store.firefox; });
        $$('[data-cta-label] [data-label]').forEach((s) => { if (s.textContent === labels.chrome) s.textContent = label; });
        $$('[data-alt]').forEach((a) => { if (firefox) { a.href = store.chrome; a.textContent = labels.chrome; a.previousElementSibling.textContent = labels.otherChrome; } });
        if (mobile) {
          $$('[data-cta-label]').forEach((a) => (a.hidden = true));
          $$('[data-share], [data-mobile-note]').forEach((b) => (b.hidden = false));
          document.body.classList.add('is-mobile');
        }
        const toast = $('[data-toast]');
        $$('[data-share]').forEach((b) => b.addEventListener('click', async () => {
          const url = location.href.split('#')[0];
          try { if (navigator.share) { await navigator.share({ title: document.title, url }); return; } } catch (e) { return; }
          try { await navigator.clipboard.writeText(url); } catch (e) {}
          toast.textContent = labels.copied; toast.classList.add('on'); setTimeout(() => toast.classList.remove('on'), 2600);
        }));

        /* Header rule and the install dock appear after the hero. */
        const bar = $('[data-bar]'), dock = $('[data-dock]'), hero = $('.hero');
        new IntersectionObserver(([e]) => { bar.classList.toggle('scrolled', !e.isIntersecting); dock.classList.toggle('on', !e.isIntersecting); }, { rootMargin: '-80px 0px 0px 0px' }).observe($('.approve'));

        /* The one motion: Portuguese strikes itself out, English is inserted. */
        const play = (el) => el.classList.add('played');
        const seen = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { play(e.target); seen.unobserve(e.target); } }), { threshold: 0.35 });
        $$('[data-strike], [data-insert], [data-reveal]').forEach((el) => (reduce ? play(el) : seen.observe(el)));

        /* Hero panel: tabs cycle through sites until the visitor picks one. */
        const tabs = $$('[data-tab]'), hunks = $$('[data-hunk]');
        let cur = 0, auto = !reduce, timer;
        const show = (i) => {
          cur = i;
          tabs.forEach((t, k) => t.setAttribute('aria-selected', String(k === i)));
          hunks.forEach((h, k) => { h.hidden = k !== i; h.classList.remove('played'); if (k === i) requestAnimationFrame(() => requestAnimationFrame(() => h.classList.add('played'))); });
        };
        tabs.forEach((t, i) => t.addEventListener('click', () => { auto = false; clearInterval(timer); show(i); }));
        show(0);
        if (auto) timer = setInterval(() => show((cur + 1) % hunkCount), 4200);

        /* Status counters tick like an instrument. */
        const counters = $$('[data-counter]');
        if (!reduce) setInterval(() => { const m = counters[0]; m.textContent = String(Math.min(99, Number(m.textContent) + 1)); }, 6000);

        /* Immersion level demo. */
        const feed = $('[data-feed]'), help = $('[data-level-help]');
        $$('[data-level]').forEach((b) => b.addEventListener('click', () => {
          $$('[data-level]').forEach((x) => x.setAttribute('aria-checked', String(x === b)));
          feed.dataset.level = b.dataset.level; help.textContent = helps[Number(b.dataset.level)];
        }));
        $$('.feed .native').forEach((li) => li.addEventListener('click', () => li.classList.toggle('revealed')));

        /* Writing Coach demo: types when it comes into view, then the correction lands. */
        const coach = $('[data-coach]'), out = $('[data-type-out]'), full = $('[data-typed]').dataset.typed;
        const runCoach = () => {
          if (reduce) { out.textContent = full; coach.classList.add('fixed'); return; }
          let i = 0; out.textContent = '';
          const step = () => { out.textContent = full.slice(0, ++i); if (i < full.length) setTimeout(step, 38 + Math.random() * 40); else setTimeout(() => coach.classList.add('fixed'), 650); };
          step();
        };
        if (reduce) runCoach();
        else new IntersectionObserver(([e], o) => { if (e.isIntersecting) { runCoach(); o.disconnect(); } }, { threshold: 0.5 }).observe(coach);

        /* Word lookup and card demo. */
        const lookup = $('[data-lookup]'), target = $('.w.target');
        const open = () => { lookup.hidden = false; target.classList.add('on'); };
        $$('.w').forEach((w) => w.addEventListener('dblclick', () => { if (w === target) open(); else { w.classList.add('nope'); setTimeout(() => w.classList.remove('nope'), 500); } }));
        target.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
        const save = $('[data-save]');
        save.addEventListener('click', () => { save.textContent = save.dataset.savedLabel; save.disabled = true; });
        $('[data-show]').addEventListener('click', (e) => { e.currentTarget.hidden = true; $('[data-answer]').hidden = false; $('[data-rates]').hidden = false; });
        $$('[data-rate]').forEach((b) => b.addEventListener('click', () => { $$('[data-rate]').forEach((x) => x.classList.toggle('on', x === b)); }));
      })();
    </script>
  </body>
</html>

<style is:global>
  /* Poster diff */
