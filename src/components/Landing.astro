---
import '../styles/site.css';
import { AUTHOR, COPY, CONTACT, EF_EPI_BRAZIL, SITE, STORE, type Lang } from '../i18n/copy';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = COPY[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const here = lang === 'pt' ? base : `${base}en/`;
const other = lang === 'pt' ? `${base}en/` : base;
const otherLang = lang === 'pt' ? 'en' : 'pt';
const img = (name: string, ext = 'jpg') => `${base}img/${lang === 'pt' ? 'pt-BR' : 'en'}-${name}.${ext}`;
const site = new URL(here, Astro.site ?? 'https://palmaxp.github.io').toString();
const ogImage = new URL(`${base}${c.meta.og}`, Astro.site ?? 'https://palmaxp.github.io').toString();

/* Icons: Lucide paths (ISC), one 2px stroke family. */
const icon = {
  check: '<path d="M20 6 9 17l-5-5"/>',
  arrow: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
  star: '<path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"/>',
  shield: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>',
  send: '<path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"/><path d="m21.854 2.147-10.94 10.939"/>',
  pause: '<rect x="14" y="4" width="4" height="16" rx="1"/><rect x="6" y="4" width="4" height="16" rx="1"/>',
  globe: '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
  keyboard: '<path d="M10 8h.01"/><path d="M12 12h.01"/><path d="M14 8h.01"/><path d="M16 12h.01"/><path d="M18 8h.01"/><path d="M6 8h.01"/><path d="M7 16h10"/><path d="M8 12h.01"/><rect width="20" height="16" x="2" y="4" rx="2"/>',
  volume: '<path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"/><path d="M16 9a5 5 0 0 1 0 6"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  question: '<path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/>',
};
const svg = (name: keyof typeof icon, cls = 'i') =>
  `<svg class="${cls}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icon[name]}</svg>`;
const stars = Array.from({ length: 5 }, () => svg('star', 'i star')).join('');
const how = c.how.blocks;
const pageUrl = new URL(here, 'https://palmaxp.github.io').toString();
const rootUrl = new URL(base, 'https://palmaxp.github.io').toString();
const enUrl = new URL(`${base}en/`, 'https://palmaxp.github.io').toString();
const stores = [STORE.chrome.split('?')[0], STORE.firefox.split('?')[0]];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${SITE}#website`, url: SITE, name: 'Active Immersion', inLanguage: ['pt-BR', 'en'], publisher: { '@id': `${SITE}#org` } },
    {
      '@type': 'Organization', '@id': `${SITE}#org`, name: 'Active Immersion', url: SITE, logo: `${SITE}icon-128.png`, email: CONTACT,
      founder: { '@id': `${SITE}#author` }, sameAs: stores,
    },
    { '@type': 'Person', '@id': `${SITE}#author`, name: AUTHOR.name, url: AUTHOR.github, sameAs: [AUTHOR.github], jobTitle: lang === 'pt' ? 'Criador do Active Immersion' : 'Creator of Active Immersion', worksFor: { '@id': `${SITE}#org` } },
    {
      '@type': 'SoftwareApplication', '@id': `${SITE}#app`, name: 'Active Immersion', url: pageUrl, image: ogImage,
      applicationCategory: 'EducationalApplication', applicationSubCategory: 'Browser extension',
      operatingSystem: 'Google Chrome, Microsoft Edge, Brave, Mozilla Firefox 140+', softwareVersion: '2.0.12',
      description: c.meta.description, installUrl: stores[0], downloadUrl: stores, inLanguage: lang === 'pt' ? 'pt-BR' : 'en',
      author: { '@id': `${SITE}#author` }, publisher: { '@id': `${SITE}#org` },
      featureList: [how[0].h, how[1].h, how[2].h, c.control.h],
      offers: [
        { '@type': 'Offer', price: '19.90', priceCurrency: 'BRL', category: 'subscription', eligibleRegion: { '@type': 'Country', name: 'BR' }, url: stores[0], description: lang === 'pt' ? '7 dias grátis sem cartão, depois R$ 19,90 por mês' : '7-day free trial with no card, then R$ 19.90 per month' },
        { '@type': 'Offer', price: '4.99', priceCurrency: 'USD', category: 'subscription', url: stores[0], description: lang === 'pt' ? '7 dias grátis sem cartão, depois US$ 4.99 por mês (fora do Brasil)' : '7-day free trial with no card, then US$ 4.99 per month (outside Brazil)' },
      ],
    },
    {
      '@type': 'WebPage', '@id': `${pageUrl}#webpage`, url: pageUrl, name: c.meta.title, description: c.meta.description,
      inLanguage: lang === 'pt' ? 'pt-BR' : 'en', isPartOf: { '@id': `${SITE}#website` }, about: { '@id': `${SITE}#app` },
      author: { '@id': `${SITE}#author` }, dateModified: '2026-09-27',
    },
    {
      '@type': 'FAQPage', '@id': `${pageUrl}#faq`, inLanguage: lang === 'pt' ? 'pt-BR' : 'en',
      mainEntity: c.faq.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-BR' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.meta.title}</title>
    <meta name="description" content={c.meta.description} />
    <link rel="canonical" href={site} />
    <link rel="alternate" hreflang="pt-BR" href={new URL(base, Astro.site ?? 'https://palmaxp.github.io').toString()} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={rootUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="author" content={AUTHOR.name} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Active Immersion" />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'pt' ? 'en_US' : 'pt_BR'} />
    <meta name="twitter:title" content={c.meta.title} />
    <meta name="twitter:description" content={c.meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="apple-touch-icon" href={`${base}icon-128.png`} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={c.meta.title} />
    <meta property="og:description" content={c.meta.description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" href={`${base}icon-32.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Spline+Sans:wght@400;500;600;700&family=Spline+Sans+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <script is:inline>
      // Motion styles apply only when scripts run and motion is welcome; otherwise every line shows its final state.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('js-motion');
    </script>
    <script is:inline define:vars={{ lang, here, other, otherLang }}>
      // First visit: follow the browser's language; a choice made with the switch wins after that.
      // Crawlers and AI agents are never redirected: each language version is indexed at its own URL.
      try {
        if (/bot|crawl|spider|slurp|google|bing|yandex|baidu|duckduck|facebookexternalhit|embed|preview|lighthouse|gpt|chatgpt|openai|perplexity|claude|anthropic|cohere|bytespider|applebot/i.test(navigator.userAgent)) throw 0;
        const saved = localStorage.getItem('ai-site-lang');
        const langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
        const want = saved || (langs.some((l) => /^pt/i.test(l)) ? 'pt' : 'en');
        if (want !== lang && want === otherLang) location.replace(other + location.hash);
      } catch (e) {}
    </script>
  </head>
  <body data-lang={lang}>
    <a class="skip" href="#install">{c.nav.install}</a>

    <header class="bar" data-bar>
      <a class="brand" href={here} aria-label="Active Immersion">
        <img src={`${base}icon-128.png`} width="28" height="28" alt="" />
        <span>Active Immersion</span>
      </a>
      <nav class="bar-actions">
        <a class="switch" href={other} data-switch={otherLang} hreflang={otherLang === 'pt' ? 'pt-BR' : 'en'} aria-label={c.nav.switchLabel}><Fragment set:html={svg('globe', 'i sm')} /> {c.nav.switchTo}</a>
        <a class="btn btn-sm" href={STORE.chrome} data-cta>{c.nav.install}</a>
      </nav>
    </header>

    <main>
      <!-- Hero: the headline is a diff -->
      <section class="hero">
        <div class="poster">
          <p class="pline del" data-strike data-gut="1  −" aria-hidden="true"><span class="ptext"><s>{c.hero.del}</s></span></p>
          <h1 class="pline ins" data-insert data-gut="1  +"><span class="ptext">{c.hero.ins}</span></h1>
        </div>

        <div class="hero-grid">
          <div class="hero-left">
            <p class="lead">{c.hero.lead}</p>
            <div class="approve" id="install">
              <div class="approve-head">
                <span class="ok"><Fragment set:html={svg('check', 'i')} /></span>
                <strong>{c.hero.ready}</strong>
              </div>
              <ul class="checks">
                {c.hero.checks.map((t) => <li><Fragment set:html={svg('check', 'i sm')} /><span>{t}</span></li>)}
              </ul>
              <a class="btn btn-lg" href={STORE.chrome} data-cta data-cta-label>
                <span data-label>{c.cta.chrome}</span>
                <small>{c.cta.sub}</small>
                <Fragment set:html={svg('arrow', 'i')} />
              </a>
              <button class="btn btn-lg btn-mobile" type="button" data-share hidden>
                <Fragment set:html={svg('send', 'i')} /><span>{c.cta.mobile}</span>
              </button>
              <p class="mobile-note" data-mobile-note hidden>{c.cta.mobileNote}</p>
              <p class="alt-link"><span data-alt-text>{c.cta.otherFirefox}</span> <a href={STORE.firefox} data-alt>{c.cta.firefox}</a></p>
              <p class="rating"><span class="stars" aria-hidden="true" set:html={stars} /><span>{c.hero.rating}</span></p>
            </div>
          </div>

          <div class="review" aria-label={c.hero.panelTitle}>
            <div class="review-head">
              <span class="mono">{c.hero.panelTitle}</span>
              <span class="count mono">{c.sites.length}</span>
              <span class="tag mono">{c.hero.example}</span>
            </div>
            <div class="tabs" role="tablist">
              {c.sites.map((s, i) => (
                <button role="tab" class="tab mono" aria-selected={i === 0 ? 'true' : 'false'} data-tab={i}>{s.host}</button>
              ))}
            </div>
            <div class="hunks">
              {c.sites.map((s, i) => (
                <div class="hunk" role="tabpanel" data-hunk={i} hidden={i !== 0}>
                  {s.lines.map((l, n) => (
                    <div class={`row ${l.t}`}>
                      <span class="ln mono">{n + 12}</span>
                      <span class="mk mono">{l.t === 'del' ? '−' : l.t === 'ins' ? '+' : ' '}</span>
                      <span class="code">{l.t === 'del' ? <s>{l.text}</s> : l.text}{'tag' in l && l.tag && <em class="flag">{l.tag}</em>}</span>
                    </div>
                  ))}
                  <div class="comment">
                    <img src={`${base}icon-128.png`} width="20" height="20" alt="" />
                    <p>{s.note}</p>
                    {'score' in s && s.score && <span class="score mono">{s.score}</span>}
                  </div>
                </div>
              ))}
            </div>
            <div class="status mono" aria-label={c.hero.example}>
              {c.hero.counters.map((label, i) => (
                <span><em data-counter={i}>{[12, 134, 24][i]}</em>{c.hero.counterUnits[i] && ` ${c.hero.counterUnits[i]}`} <small>{label}</small></span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- A day, as a change history that rises -->
      <section class="day">
        <div class="wrap">
          <h2>{c.day.h}</h2>
          <p class="sub">{c.day.p} <span class="tag mono">{c.day.label}</span></p>
          <ol class="log">
            {c.day.items.map((it) => (
              <li class="commit" data-reveal>
                <span class="time mono">{it.time}</span>
                <span class="dot" aria-hidden="true"></span>
                <div class="commit-body">
                  <span class="place mono">{it.place}</span>
                  <p class="cdel"><span class="mk mono" aria-hidden="true">−</span><s>{it.del}</s></p>
                  <p class="cins"><span class="mk mono" aria-hidden="true">+</span>{it.ins}</p>
                  {'note' in it && it.note && <p class="cnote">{it.note}</p>}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- The three changes, each proven with a demo and the real product -->
      <section class="how">
        <div class="wrap">
          <h2>{c.how.h}</h2>
          <p class="sub answer">{c.how.a}</p>
        </div>

        <article class="file">
          <div class="file-grid wrap">
            <div class="file-copy">
              <h3>{how[0].h}</h3>
              <p>{how[0].p}</p>
              <div class="seg" role="radiogroup" data-levels>
                {how[0].levels.map((l, i) => (
                  <button type="button" role="radio" aria-checked={i === 1 ? 'true' : 'false'} data-level={i}>{l}</button>
                ))}
              </div>
              <p class="seg-help" data-level-help>{how[0].levelHelp[1]}</p>
            </div>
            <div class="browser" data-feed data-level="1">
              <div class="chrome"><i></i><i></i><i></i><span class="mono">youtube.com</span></div>
              <ul class="feed">
                <li><div class="fi"><span class="thumb t1"></span><span>How I learned English by watching series</span></div></li>
                <li class="native"><div class="fi"><span class="thumb t2"></span><span class="nt">10 hábitos simples que vão mudar a sua rotina</span><em class="hidden-chip mono">{how[0].hidden}</em></div></li>
                <li><div class="fi"><span class="thumb t3"></span><span>The history of the internet in 20 minutes</span></div></li>
                <li class="native"><div class="fi"><span class="thumb t4"></span><span class="nt">Receita de pão caseiro fácil e rápida</span><em class="hidden-chip mono">{how[0].hidden}</em></div></li>
                <li><div class="fi"><span class="thumb t5"></span><span>A beginner guide to cooking pasta at home</span></div></li>
              </ul>
            </div>
          </div>
        </article>

        <article class="file">
          <div class="file-grid wrap flip">
            <div class="file-copy">
              <h3>{how[1].h}</h3>
              <p>{how[1].p}</p>
            </div>
            <div class="coach" data-coach>
              <div class="chat">
                <span class="mono chat-host">mail.google.com</span>
                <p class="typed" data-typed={how[1].typed} aria-label={how[1].typed}><span data-type-out></span><span class="caret" aria-hidden="true"></span></p>
              </div>
              <div class="correction" data-correction><div class="correction-in">
                <div class="row del"><span class="mk mono">−</span><span class="code"><s>{how[1].typed}</s></span></div>
                <div class="row ins"><span class="mk mono">+</span><span class="code">{how[1].fixed}</span></div>
                <div class="comment">
                  <img src={`${base}icon-128.png`} width="20" height="20" alt="" />
                  <p>{how[1].why}</p>
                  <span class="score mono">72</span>
                </div>
              </div></div>
            </div>
          </div>
          <figure class="shot wrap desk-only"><picture><source type="image/webp" srcset={img('coach', 'webp')} /><img src={img('coach')} width="1600" height="1000" loading="lazy" decoding="async" alt={c.how.shots.alt[1]} /></picture></figure>
        </article>

        <article class="file">
          <div class="file-grid wrap">
            <div class="file-copy">
              <h3>{how[2].h}</h3>
              <p>{how[2].p}</p>
            </div>
            <div class="words">
              <p class="sentence" data-sentence>
                {how[2].sentence.split(' ').map((w) => (
                  <><span class:list={['w', w.replace(/[^A-Za-z]/g, '') === how[2].word && 'target']} tabindex={w.replace(/[^A-Za-z]/g, '') === how[2].word ? 0 : -1}>{w}</span>{' '}</>
                ))}
              </p>
              <p class="hint">{how[2].hint}</p>
              <div class="lookup" data-lookup hidden>
                <div class="lk-head"><strong>{how[2].word}</strong><span class="mono">/ˈstrʌɡ.əl/</span><Fragment set:html={svg('volume', 'i sm')} /></div>
                <p><em>verb</em> · {how[2].def}</p>
                <button type="button" class="btn btn-sm" data-save data-saved-label={how[2].saved}>{how[2].save}</button>
              </div>
              <div class="card" data-card>
                <div class="card-face">
                  <strong>{how[2].word}</strong>
                  <em>“I still struggle with phrasal verbs.”</em>
                  <button type="button" class="ghost" data-show>{how[2].show}</button>
                  <div class="answer" hidden data-answer>
                    <b>{how[2].meaning}</b>
                    <span>{how[2].def}</span>
                  </div>
                </div>
                <div class="rates" hidden data-rates>
                  {how[2].ratings.map((r, i) => (
                    <button type="button" data-rate={i}><span>{r}</span><small class="mono">{how[2].back[i]}</small></button>
                  ))}
                </div>
              </div>
            </div>
          </div>
          <figure class="shot wrap"><picture><source media="(max-width: 900px)" type="image/webp" srcset={img('page-lookup-m', 'webp')} width="500" height="380" /><source media="(max-width: 900px)" srcset={img('page-lookup-m')} width="500" height="380" /><source type="image/webp" srcset={img('page-lookup', 'webp')} /><img src={img('page-lookup')} width="1600" height="1000" loading="lazy" decoding="async" alt={c.how.shots.alt[0]} /></picture></figure>
        </article>
      </section>

      <!-- Versus: split diff, as a real table -->
      <section class="versus">
        <div class="wrap">
          <h2>{c.versus.h}</h2>
          <p class="sub answer">{c.versus.a} <a class="src" href={EF_EPI_BRAZIL} rel="noopener" target="_blank">{c.versus.source}</a></p>
          <table class="vs">
            <thead><tr><th scope="col"><span class="mk mono" aria-hidden="true">−</span>{c.versus.cols[0]}</th><th scope="col"><span class="mk mono" aria-hidden="true">+</span>{c.versus.cols[1]}</th></tr></thead>
            <tbody>
              {c.versus.rows.map((r, i) => (
                <tr class="vs-pair" data-reveal>
                  <td class="del"><span class="ln mono" aria-hidden="true">{i + 1}</span><s>{r.del}</s></td>
                  <td class="ins"><span class="ln mono" aria-hidden="true">{i + 1}</span><span class="code">{r.ins}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <!-- Control and breaks -->
      <section class="control">
        <div class="wrap control-grid">
          <div>
            <h2>{c.control.h}</h2>
            <p class="sub">{c.control.p}</p>
            <ul class="plain">
              <li><Fragment set:html={svg('globe', 'i')} /><span>{c.control.points[0]}</span></li>
              <li><Fragment set:html={svg('pause', 'i')} /><span>{c.control.points[1]}</span></li>
              <li><Fragment set:html={svg('keyboard', 'i')} /><span>{c.control.points[2]}</span></li>
            </ul>
          </div>
          <figure class="popup"><picture><source type="image/webp" srcset={img('popup-break', 'webp')} /><img src={img('popup-break')} width="380" height="620" loading="lazy" decoding="async" alt={c.control.alt} /></picture></figure>
        </div>
      </section>

      <!-- Proof: rating and the founder's note as a review comment -->
      <section class="proof">
        <div class="wrap">
          <h2>{c.proof.h}</h2>
          <p class="sub answer">{c.proof.a}</p>
          <div class="thread">
            <div class="thread-head">
              <span class="avatar mono" aria-hidden="true">J</span>
              <strong>{c.proof.who}</strong>
            </div>
            <blockquote>{c.proof.note}</blockquote>
            <p class="rating"><span class="stars" aria-hidden="true" set:html={stars} /><span>{c.proof.stars}</span></p>
          </div>
        </div>
      </section>

      <!-- Price: the trial as a change history, the plan as an approval box -->
      <section class="price" id="price">
        <div class="wrap price-grid">
          <div>
            <h2>{c.price.h}</h2>
            <p class="sub">{c.price.p}</p>
            <ol class="log compact">
              {c.price.history.map(([when, what]) => (
                <li class="commit played">
                  <span class="time mono">{when}</span>
                  <span class="dot" aria-hidden="true"></span>
                  <p class="commit-line">{what}</p>
                </li>
              ))}
            </ol>
          </div>
          <div class="approve big">
            <div class="approve-head">
              <span class="ok"><Fragment set:html={svg('check', 'i')} /></span>
              <strong>{c.price.passed}</strong>
            </div>
            <div class="amount"><strong>{c.price.amount}</strong><span>{c.price.per}</span></div>
            <p class="daily">{c.price.daily}<br />{c.price.abroad}</p>
            <ul class="status-checks">
              {c.price.checks.map((t) => <li><Fragment set:html={svg('check', 'i sm')} /><span>{t}</span><em class="mono">{c.price.tag}</em></li>)}
            </ul>
