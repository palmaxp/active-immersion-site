  .poster { display: grid; gap: 0; margin: 0 0 clamp(28px, 5vh, 48px); font-weight: 700; font-size: clamp(2.3rem, 5.6vw, 5.25rem); line-height: 1.02; letter-spacing: -0.04em; }
  .pline { display: grid; grid-template-columns: max(20px, calc((100vw - 1180px) / 2)) 1fr; align-items: stretch; padding-right: 20px; }
  .pline { margin: 0; font: inherit; letter-spacing: inherit; }
  .pline::before { content: attr(data-gut); white-space: pre; text-align: right; padding: 0.3em 16px 0 0; font: 700 clamp(13px, 1.1vw, 17px)/1 var(--mono); letter-spacing: 0; }
