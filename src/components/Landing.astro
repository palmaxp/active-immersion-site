  /* Review panel */
  .review { border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: var(--paper); box-shadow: 0 1px 2px rgba(31, 35, 40, 0.06), 0 30px 60px -34px rgba(31, 35, 40, 0.45); }
