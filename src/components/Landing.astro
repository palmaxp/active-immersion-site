  .approve { border: 1px solid var(--line); border-radius: 14px; padding: 18px; background: var(--paper); box-shadow: 0 1px 2px rgba(31, 35, 40, 0.06), 0 18px 40px -26px rgba(31, 35, 40, 0.35); }
