---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy Policy — Active Immersion">
  <!-- Ambient Glow -->
  <div style="position:fixed;top:-20%;right:-10%;width:600px;height:600px;background:radial-gradient(circle,rgba(245,158,11,0.06)0%,transparent 70%);pointer-events:none;z-index:0;"></div>
  
  <!-- Navigation -->
  <nav style="position:fixed;top:0;left:0;right:0;z-index:100;padding:16px 28px;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(180deg,rgba(9,9,11,0.9)0%,transparent 100%);backdrop-filter:blur(8px);">
    <a href="/active-immersion-site/" style="display:flex;align-items:center;gap:12px;text-decoration:none;color:inherit;">
      <div style="width:36px;height:36px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#f59e0b,#d97706);color:#000;font-weight:900;font-size:18px;font-family:var(--font-display);border-radius:10px;">A</div>
      <span style="font-size:15px;font-weight:700;letter-spacing:-0.02em;">Active Immersion</span>
    </a>
    <a href="/active-immersion-site/" style="font-size:13px;color:var(--text-secondary);text-decoration:none;">← Back to home</a>
  </nav>

  <main style="position:relative;z-index:1;padding-top:100px;">
    <section style="padding:60px 24px;max-width:680px;margin:0 auto;">
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:48px;">
        <span style="flex:1;height:1px;background:linear-gradient(90deg,transparent,var(--border-strong));"></span>
        <span style="font-size:11px;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;color:#f59e0b;">Legal</span>
        <span style="flex:1;height:1px;background:linear-gradient(90deg,var(--border-strong),transparent);"></span>
      </div>
      
      <h1 style="font-family:var(--font-display);font-size:clamp(32px,5vw,48px);font-weight:700;line-height:1.1;letter-spacing:-0.02em;margin-bottom:16px;text-align:center;">Privacy Policy</h1>
      <p style="text-align:center;color:var(--text-muted);font-size:14px;margin-bottom:64px;">Effective Date: May 4, 2026</p>

      <!-- Section 1 -->
      <div style="margin-bottom:48px;">
        <h2 style="font-family:var(--font-display);font-size:24px;font-weight:700;margin-bottom:16px;color:#f59e0b;">1. What We Collect</h2>
        
        <h3 style="font-size:16px;font-weight:700;margin-bottom:12px;margin-top:24px;">Locally (on your device)</h3>
        <ul style="color:var(--text-secondary);line-height:1.7;padding-left:20px;">
          <li>Extension settings (theme, mode, whitelist, API keys)</li>
          <li>Captured English text snippets you write on websites (for the Analyzer feature)</li>
          <li>Flashcard data (Immersion Deck)</li>
          <li>Daily AI usage counters</li>
        </ul>

        <h3 style="font-size:16px;font-weight:700;margin-bottom:12px;margin-top:24px;">Sent to our servers (Supabase)</h3>
        <ul style="color:var(--text-secondary);line-height:1.7;padding-left:20px;">
          <li>Account info (email, user ID)</li>
          <li>Your saved settings, writings, deck cards, and AI usage stats</li>
          <li>Everything is tied to your authenticated account only</li>
        </ul>

        <h3 style="font-size:16px;font-weight:700;margin-bottom:12px;margin-top:24px;">Sent to OpenAI</h3>
        <ul style="color:var(--text-secondary);line-height:1.7;padding-left:20px;">
          <li>Text snippets you explicitly choose to analyze or validate</li>
          <li>Only when you provide your own OpenAI API key (Pro users)</li>
        </ul>
      </div>

      <!-- Section 2 -->
      <div style="margin-bottom:48px;">
        <h2 style="font-family:var(--font-display);font-size:24px;font-weight:700;margin-bottom:16px;color:#f59e0b;">2. Why We Collect It</h2>
        <ul style="color:var(--text-secondary);line-height:1.7;padding-left:20px;">
          <li>To sync your data across devices</li>
          <li>To run the English Analyzer and AI language detection</li>
          <li>To enforce plan limits (Free vs Pro)</li>
        </ul>
      </div>

      <!-- Section 3 -->
      <div style="margin-bottom:48px;">
        <h2 style="font-family:var(--font-display);font-size:24px;font-weight:700;margin-bottom:16px;color:#f59e0b;">3. Data Storage & Security</h2>
        <ul style="color:var(--text-secondary);line-height:1.7;padding-left:20px;">
          <li>All cloud data is stored in <strong style="color:var(--text);">Supabase</strong> (PostgreSQL) with Row Level Security (RLS)</li>
          <li>Passwords are handled by <strong style="color:var(--text);">Supabase Auth</strong> (bcrypt hashed)</li>
          <li>We do <strong style="color:var(--text);">not</strong> sell or share your data with third parties</li>
          <li>OpenAI API calls are made directly from your browser using <strong style="color:var(--text);">your own key</strong></li>
        </ul>
      </div>

      <!-- Section 4 -->
      <div style="margin-bottom:48px;">
        <h2 style="font-family:var(--font-display);font-size:24px;font-weight:700;margin-bottom:16px;color:#f59e0b;">4. Your Rights</h2>
        <p style="color:var(--text-secondary);line-height:1.7;">You can request deletion of all your data at any time by contacting us or deleting your account in the extension settings.</p>
      </div>

      <!-- Section 5 -->
      <div style="margin-bottom:48px;">
        <h2 style="font-family:var(--font-display);font-size:24px;font-weight:700;margin-bottom:16px;color:#f59e0b;">5. Contact</h2>
        <p style="color:var(--text-secondary);line-height:1.7;">For privacy questions or data deletion requests, open an issue on the <a href="https://github.com" style="color:#f59e0b;text-decoration:none;">GitHub repository</a>.</p>
      </div>

      <!-- Divider -->
      <div style="height:1px;background:linear-gradient(90deg,transparent,var(--border-strong),transparent);margin:48px 0;"></div>

      <p style="text-align:center;color:var(--text-muted);font-size:13px;"><em>Active Immersion does not track you across websites or serve ads.</em></p>
    </section>

    <!-- Footer -->
    <footer style="padding:40px 24px;text-align:center;border-top:1px solid var(--border);max-width:800px;margin:0 auto;">
      <div style="display:flex;align-items:center;justify-content:center;gap:12px;margin-bottom:16px;">
        <div style="width:32px;height:32px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#f59e0b,#d97706);color:#000;font-weight:900;font-size:14px;font-family:var(--font-display);border-radius:8px;">A</div>
        <span style="font-size:15px;font-weight:700;">Active Immersion</span>
      </div>
      <p style="font-size:13px;color:var(--text-muted);margin-bottom:8px;">Language Acquisition Protocol v1.0.5</p>
      <p style="font-size:12px;color:var(--text-muted);opacity:0.6;">Built with science. Designed for immersion.</p>
    </footer>
  </main>
</Layout>
