---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Ambient Glow -->
  <div style="position:fixed;top:-20%;right:-10%;width:600px;height:600px;background:radial-gradient(circle,rgba(245,158,11,0.06)0%,transparent 70%);pointer-events:none;z-index:0;animation:ambientFloat 20s ease-in-out infinite;"></div>
  
  <!-- Navigation -->
  <nav style="position:fixed;top:0;left:0;right:0;z-index:100;padding:16px 28px;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(180deg,rgba(9,9,11,0.9)0%,transparent 100%);backdrop-filter:blur(8px);">
    <div style="display:flex;align-items:center;gap:12px;">
      <div style="width:36px;height:36px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#f59e0b,#d97706);color:#000;font-weight:900;font-size:18px;font-family:var(--font-display);border-radius:10px;box-shadow:0 4px 16px rgba(245,158,11,0.2);">A</div>
      <span style="font-size:15px;font-weight:700;letter-spacing:-0.02em;">Active Immersion</span>
    </div>
    <div style="display:flex;align-items:center;gap:8px;">
      <span style="font-size:11px;color:var(--text-muted);font-weight:500;">v1.0.5</span>
      <span style="display:flex;align-items:center;gap:6px;padding:4px 12px;background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.2);border-radius:999px;">
        <span style="width:6px;height:6px;background:#f59e0b;border-radius:50%;animation:pulse 2s ease-in-out infinite;box-shadow:0 0 6px rgba(245,158,11,0.3);"></span>
        <span style="font-size:11px;font-weight:600;color:#f59e0b;">Online</span>
      </span>
    </div>
  </nav>

  <main style="position:relative;z-index:1;">
    
    <!-- ==================== HERO ==================== -->
    <section class="hero-section" style="min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:120px 24px 80px;max-width:800px;margin:0 auto;">
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:32px;opacity:0;animation:fadeInUp 0.8s ease 0.1s forwards;">
        <span style="flex:1;height:1px;max-width:60px;background:linear-gradient(90deg,transparent,#f59e0b);"></span>
        <span style="font-size:11px;font-weight:700;letter-spacing:0.2em;text-transform:uppercase;color:#f59e0b;">Language Acquisition Protocol</span>
        <span style="flex:1;height:1px;max-width:60px;background:linear-gradient(90deg,#f59e0b,transparent);"></span>
      </div>
      
      <h1 class="hero-title" style="font-family:var(--font-display);font-size:clamp(40px,7vw,68px);font-weight:700;line-height:1.08;letter-spacing:-0.03em;margin-bottom:28px;">
        <span style="display:block;opacity:0;animation:fadeInUp 0.8s ease 0.2s forwards;">Your brain is</span>
        <span style="display:block;background:linear-gradient(135deg,#f59e0b 0%,#fbbf24 50%,#fde68a 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;opacity:0;animation:fadeInUp 0.8s ease 0.35s forwards;">wired for English.</span>
        <span style="display:block;opacity:0;animation:fadeInUp 0.8s ease 0.5s forwards;">You just need to</span>
        <span style="display:block;background:linear-gradient(135deg,#f59e0b 0%,#fbbf24 50%,#fde68a 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;opacity:0;animation:fadeInUp 0.8s ease 0.65s forwards;">flip the switch.</span>
      </h1>
      
      <p class="hero-subtitle" style="font-size:18px;color:var(--text-secondary);line-height:1.7;max-width:560px;margin-bottom:40px;opacity:0;animation:fadeInUp 0.8s ease 0.8s forwards;">
        The browser extension that forces English immersion into your daily life.
        No courses. No grammar drills. Just <em style="color:#f59e0b;font-family:var(--font-display);font-style:italic;">pure immersion</em>.
      </p>
      
      <div style="display:flex;flex-wrap:wrap;gap:12px;justify-content:center;opacity:0;animation:fadeInUp 0.8s ease 0.95s forwards;">
        <button class="btn-primary" disabled style="display:flex;align-items:center;gap:10px;padding:14px 28px;background:linear-gradient(135deg,#f59e0b,#d97706);color:#000;border:none;border-radius:12px;font-family:var(--font-ui);font-size:15px;font-weight:700;cursor:not-allowed;opacity:0.5;box-shadow:0 4px 24px rgba(245,158,11,0.2);">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
          Chrome Extension
          <span style="font-size:10px;font-weight:600;padding:2px 8px;background:rgba(0,0,0,0.2);border-radius:999px;">Soon</span>
        </button>
        <button class="btn-secondary" disabled style="display:flex;align-items:center;gap:10px;padding:14px 28px;background:var(--elevated);color:var(--text-secondary);border:1px solid var(--border);border-radius:12px;font-family:var(--font-ui);font-size:15px;font-weight:700;cursor:not-allowed;opacity:0.5;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>
          Firefox Add-on
          <span style="font-size:10px;font-weight:600;padding:2px 8px;background:rgba(255,255,255,0.05);border-radius:999px;">Soon</span>
        </button>
      </div>
    </section>

    <!-- ==================== THE PROBLEM ==================== -->
    <section style="padding:80px 24px;max-width:800px;margin:0 auto;">
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:48px;" data-reveal>
        <span style="font-family:var(--font-display);font-size:14px;font-weight:700;color:#f59e0b;opacity:0.6;">01</span>
        <h2 style="font-family:var(--font-display);font-size:clamp(26px,4vw,36px);font-weight:700;letter-spacing:-0.02em;">The Reality</h2>
      </div>
      
      <div class="reality-grid" style="display:grid;grid-template-columns:1fr auto 1fr;gap:20px;align-items:stretch;" data-reveal>
        <!-- Without Immersion -->
        <div class="concept-card" style="background:linear-gradient(180deg,var(--card) 0%,rgba(18,16,20,0.6) 100%);border:1px solid var(--border);border-radius:16px;padding:32px;display:flex;flex-direction:column;">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
            <span style="font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.12em;color:var(--text-muted);background:var(--elevated);padding:4px 12px;border-radius:999px;border:1px solid var(--border);">Without Immersion</span>
            <span style="font-size:28px;">🇧🇷</span>
          </div>
          <h3 style="font-family:var(--font-display);font-size:22px;font-weight:700;margin-bottom:12px;">No Immersion</h3>
          <p style="font-size:15px;color:var(--text-secondary);line-height:1.7;margin-bottom:24px;flex:1;">You study English for 1 hour a day... and spend the other 15 hours in Portuguese. Your brain never switches to English mode.</p>
          <div>
            <div style="height:4px;background:var(--elevated);border-radius:2px;overflow:hidden;margin-bottom:8px;">
              <div class="exposure-bar" data-width="6" style="height:100%;width:0%;background:linear-gradient(90deg,var(--text-muted),var(--text-secondary));border-radius:2px;transition:width 1.5s ease;"></div>
            </div>
            <span style="font-size:11px;color:var(--text-muted);font-weight:600;letter-spacing:0.05em;">6% exposure / day</span>
          </div>
        </div>
        
        <!-- VS -->
        <div class="vs-divider" style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;min-width:40px;">
          <div class="vs-line" style="width:1px;flex:1;background:linear-gradient(180deg,transparent,var(--border-strong),transparent);min-height:40px;"></div>
          <span style="font-size:11px;font-weight:800;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.15em;">vs</span>
          <div class="vs-line" style="width:1px;flex:1;background:linear-gradient(180deg,transparent,var(--border-strong),transparent);min-height:40px;"></div>
        </div>
        
        <!-- With Immersion -->
        <div style="background:linear-gradient(180deg,var(--card) 0%,rgba(18,16,20,0.6) 100%);border:1px solid rgba(245,158,11,0.2);border-radius:16px;padding:32px;display:flex;flex-direction:column;box-shadow:0 0 24px rgba(245,158,11,0.08);">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
            <span style="font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:0.12em;color:#f59e0b;background:rgba(245,158,11,0.1);padding:4px 12px;border-radius:999px;border:1px solid rgba(245,158,11,0.2);">With Active Immersion</span>
            <span style="font-size:28px;opacity:0.8;">🇺🇸</span>
          </div>
          <h3 style="font-family:var(--font-display);font-size:22px;font-weight:700;margin-bottom:12px;">Full Immersion</h3>
          <p style="font-size:15px;color:var(--text-secondary);line-height:1.7;margin-bottom:24px;flex:1;">Your day is surrounded by English. You think, read, write, and consume content in English naturally. Your brain adapts.</p>
          <div>
            <div style="height:4px;background:var(--elevated);border-radius:2px;overflow:hidden;margin-bottom:8px;">
              <div class="exposure-bar" data-width="85" style="height:100%;width:0%;background:linear-gradient(90deg,#f59e0b,#fbbf24);border-radius:2px;transition:width 1.5s ease;box-shadow:0 0 8px rgba(245,158,11,0.3);"></div>
            </div>
            <span style="font-size:11px;color:#f59e0b;font-weight:600;letter-spacing:0.05em;">85% exposure / day</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== THE SCIENCE ==================== -->
    <section style="padding:80px 24px;max-width:800px;margin:0 auto;">
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:48px;" data-reveal>
        <span style="font-family:var(--font-display);font-size:14px;font-weight:700;color:#f59e0b;opacity:0.6;">02</span>
        <h2 style="font-family:var(--font-display);font-size:clamp(26px,4vw,36px);font-weight:700;letter-spacing:-0.02em;">Why Immersion Works</h2>
      </div>
      
      <div style="display:flex;flex-direction:column;gap:16px;">
        <div style="background:linear-gradient(135deg,var(--card) 0%,rgba(18,16,20,0.4) 100%);border:1px solid var(--border);border-radius:16px;padding:28px;position:relative;overflow:hidden;" data-reveal>
          <div style="position:absolute;top:0;left:0;width:3px;height:100%;background:linear-gradient(180deg,#f59e0b,transparent 80%);opacity:0.5;"></div>
          <h3 style="font-size:17px;font-weight:700;margin-bottom:8px;padding-left:12px;">The Science Behind It</h3>
          <p style="font-size:15px;color:var(--text-secondary);line-height:1.7;padding-left:12px;">
            Research from language immersion programs worldwide shows that students who are fully immersed in a second language 
            develop <strong style="color:var(--text);">native-like comprehension</strong> and significantly outperform peers in standardized tests. 
            Canada's French immersion program, started in 1965, demonstrated that students didn't lose proficiency in their native language 
            while achieving fluency in the second.
          </p>
        </div>
        
        <div class="stats-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;">
          <div style="background:linear-gradient(135deg,var(--card) 0%,rgba(18,16,20,0.4) 100%);border:1px solid var(--border);border-radius:16px;padding:24px;text-align:center;" data-reveal>
            <div style="font-family:var(--font-display);font-size:36px;font-weight:800;background:linear-gradient(135deg,#f59e0b,#fbbf24);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:8px;">528+</div>
            <div style="font-size:13px;color:var(--text-secondary);font-weight:500;">Immersion schools in the US</div>
          </div>
          <div style="background:linear-gradient(135deg,var(--card) 0%,rgba(18,16,20,0.4) 100%);border:1px solid var(--border);border-radius:16px;padding:24px;text-align:center;" data-reveal>
            <div style="font-family:var(--font-display);font-size:36px;font-weight:800;background:linear-gradient(135deg,#f59e0b,#fbbf24);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:8px;">300K+</div>
            <div style="font-size:13px;color:var(--text-secondary);font-weight:500;">Students in Canadian immersion</div>
          </div>
          <div style="background:linear-gradient(135deg,var(--card) 0%,rgba(18,16,20,0.4) 100%);border:1px solid var(--border);border-radius:16px;padding:24px;text-align:center;" data-reveal>
            <div style="font-family:var(--font-display);font-size:36px;font-weight:800;background:linear-gradient(135deg,#f59e0b,#fbbf24);-webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:8px;">4-10</div>
            <div style="font-size:13px;color:var(--text-secondary);font-weight:500;">Years to advanced fluency</div>
          </div>
        </div>
        
        <div style="background:linear-gradient(135deg,var(--card) 0%,rgba(18,16,20,0.4) 100%);border:1px solid var(--border);border-radius:16px;padding:28px;position:relative;overflow:hidden;" data-reveal>
          <div style="position:absolute;top:0;left:0;width:3px;height:100%;background:linear-gradient(180deg,#f59e0b,transparent 80%);opacity:0.5;"></div>
          <h3 style="font-size:17px;font-weight:700;margin-bottom:8px;padding-left:12px;">But There's a Catch</h3>
          <p style="font-size:15px;color:var(--text-secondary);line-height:1.7;padding-left:12px;">
            Traditional immersion programs require you to physically relocate or attend special schools. 
            <strong style="color:var(--text);">Active Immersion</strong> brings the same principle to your browser. 
            By blocking Portuguese content and forcing English interaction, it creates a <em style="color:#f59e0b;font-family:var(--font-display);">digital immersion environment</em> 
            without you changing a single habit.
          </p>
        </div>
      </div>
    </section>

    <!-- ==================== FEATURES ==================== -->
    <section style="padding:80px 24px;max-width:800px;margin:0 auto;">
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:48px;" data-reveal>
        <span style="font-family:var(--font-display);font-size:14px;font-weight:700;color:#f59e0b;opacity:0.6;">03</span>
        <h2 style="font-family:var(--font-display);font-size:clamp(26px,4vw,36px);font-weight:700;letter-spacing:-0.02em;">Your Toolkit</h2>
      </div>
      
      <div style="display:flex;flex-direction:column;gap:16px;">
        <!-- Smart Blocker -->
        <div class="feature-card" style="display:flex;align-items:flex-start;gap:20px;background:linear-gradient(135deg,var(--card) 0%,rgba(18,16,20,0.4) 100%);border:1px solid var(--border);border-radius:16px;padding:28px;position:relative;overflow:hidden;transition:all 0.4s ease;" data-reveal onmouseenter="this.style.borderColor='var(--border-strong)';this.style.transform='translateX(6px)';this.style.boxShadow='0 4px 16px rgba(0,0,0,0.3)'" onmouseleave="this.style.borderColor='var(--border)';this.style.transform='';this.style.boxShadow=''">
          <div style="position:absolute;top:0;left:0;width:3px;height:100%;background:linear-gradient(180deg,#f59e0b,transparent 80%);opacity:0.5;transition:opacity 0.3s;" class="feature-line"></div>
          <div style="width:52px;height:52px;display:flex;align-items:center;justify-content:center;background:var(--elevated);border-radius:12px;color:#f59e0b;flex-shrink:0;border:1px solid var(--border);transition:all 0.3s ease;" class="feature-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <div style="flex:1;display:flex;flex-direction:column;gap:6px;">
            <h4 style="font-size:17px;font-weight:700;color:var(--text);">Smart Blocker</h4>
            <p style="font-size:14px;color:var(--text-secondary);line-height:1.6;">Detects Portuguese text, titles, links, and search queries across the web and hides them automatically. YouTube, Google, news sites — all filtered in real-time.</p>
          </div>
          <div class="feature-number" style="font-family:var(--font-display);font-size:32px;font-weight:700;color:var(--text);opacity:0.04;line-height:1;align-self:flex-start;">01</div>
        </div>
        
        <!-- English Analyzer -->
        <div class="feature-card" style="display:flex;align-items:flex-start;gap:20px;background:linear-gradient(135deg,var(--card) 0%,rgba(18,16,20,0.4) 100%);border:1px solid var(--border);border-radius:16px;padding:28px;position:relative;overflow:hidden;transition:all 0.4s ease;" data-reveal onmouseenter="this.style.borderColor='var(--border-strong)';this.style.transform='translateX(6px)';this.style.boxShadow='0 4px 16px rgba(0,0,0,0.3)'" onmouseleave="this.style.borderColor='var(--border)';this.style.transform='';this.style.boxShadow=''">
          <div style="position:absolute;top:0;left:0;width:3px;height:100%;background:linear-gradient(180deg,#f59e0b,transparent 80%);opacity:0.5;"></div>
          <div style="width:52px;height:52px;display:flex;align-items:center;justify-content:center;background:var(--elevated);border-radius:12px;color:#f59e0b;flex-shrink:0;border:1px solid var(--border);">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          </div>
          <div style="flex:1;display:flex;flex-direction:column;gap:6px;">
            <h4 style="font-size:17px;font-weight:700;color:var(--text);">English Analyzer <span style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#f59e0b;background:rgba(245,158,11,0.1);padding:2px 8px;border-radius:999px;border:1px solid rgba(245,158,11,0.2);margin-left:8px;">Pro</span></h4>
            <p style="font-size:14px;color:var(--text-secondary);line-height:1.6;">Saves every English sentence you write on the web and analyzes it with AI. Get instant grammar feedback, vocabulary suggestions, and a corrected version to learn from.</p>
          </div>
          <div class="feature-number" style="font-family:var(--font-display);font-size:32px;font-weight:700;color:var(--text);opacity:0.04;line-height:1;align-self:flex-start;">02</div>
        </div>
        
        <!-- Search Guardian -->
        <div class="feature-card" style="display:flex;align-items:flex-start;gap:20px;background:linear-gradient(135deg,var(--card) 0%,rgba(18,16,20,0.4) 100%);border:1px solid var(--border);border-radius:16px;padding:28px;position:relative;overflow:hidden;transition:all 0.4s ease;" data-reveal onmouseenter="this.style.borderColor='var(--border-strong)';this.style.transform='translateX(6px)';this.style.boxShadow='0 4px 16px rgba(0,0,0,0.3)'" onmouseleave="this.style.borderColor='var(--border)';this.style.transform='';this.style.boxShadow=''">
          <div style="position:absolute;top:0;left:0;width:3px;height:100%;background:linear-gradient(180deg,#f59e0b,transparent 80%);opacity:0.5;"></div>
          <div style="width:52px;height:52px;display:flex;align-items:center;justify-content:center;background:var(--elevated);border-radius:12px;color:#f59e0b;flex-shrink:0;border:1px solid var(--border);">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
          </div>
          <div style="flex:1;display:flex;flex-direction:column;gap:6px;">
            <h4 style="font-size:17px;font-weight:700;color:var(--text);">Search Guardian <span style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#f59e0b;background:rgba(245,158,11,0.1);padding:2px 8px;border-radius:999px;border:1px solid rgba(245,158,11,0.2);margin-left:8px;">Pro</span></h4>
            <p style="font-size:14px;color:var(--text-secondary);line-height:1.6;">If you try searching in Portuguese on Google or YouTube, the extension blocks it and reminds you: "write in English." Forces your brain to think in the target language.</p>
          </div>
          <div class="feature-number" style="font-family:var(--font-display);font-size:32px;font-weight:700;color:var(--text);opacity:0.04;line-height:1;align-self:flex-start;">03</div>
        </div>
        
        <!-- Immersion Deck -->
        <div class="feature-card" style="display:flex;align-items:flex-start;gap:20px;background:linear-gradient(135deg,var(--card) 0%,rgba(18,16,20,0.4) 100%);border:1px solid var(--border);border-radius:16px;padding:28px;position:relative;overflow:hidden;transition:all 0.4s ease;" data-reveal onmouseenter="this.style.borderColor='var(--border-strong)';this.style.transform='translateX(6px)';this.style.boxShadow='0 4px 16px rgba(0,0,0,0.3)'" onmouseleave="this.style.borderColor='var(--border)';this.style.transform='';this.style.boxShadow=''">
          <div style="position:absolute;top:0;left:0;width:3px;height:100%;background:linear-gradient(180deg,#f59e0b,transparent 80%);opacity:0.5;"></div>
          <div style="width:52px;height:52px;display:flex;align-items:center;justify-content:center;background:var(--elevated);border-radius:12px;color:#f59e0b;flex-shrink:0;border:1px solid var(--border);">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <div style="flex:1;display:flex;flex-direction:column;gap:6px;">
